# انسخ هذا الملف إلى .env.local وعبّي القيم من:
# Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration
# نفس المتغيرات لازم تنضاف في Netlify: Site configuration → Environment variables
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# اختياري — خريطة الأساس في لوحة قدرة استعادة الخدمة. الافتراضي OpenStreetMap بتعتيم CSS.
# لو عندك مفتاح لمزوّد خرائط داكنة (CARTO / Stadia / MapTiler) حط رابط البلاطات {z}/{x}/{y} هنا مع نص الإسناد.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# للاختبارات الآلية فقط، وما يشتغل إلا والمفاتيح فوق فاضية: يفتح لوحة /restoration على البيانات التجريبية.
# في أي نسخة فيها مفاتيح Firebase ما له أي أثر (شوف README ← «الصفحة خاصة»). لا تضيفه في Netlify.
# VITE_E2E_OPEN=1
